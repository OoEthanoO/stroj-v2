# Judge settings for this deployment that are safe to keep in the repository.
#
# bootstrap-judge.sh reads this file on every deploy, after auto-update.sh has
# carried the running container's settings over, so a value here wins over the
# carried one: change it, push, and the next deploy uses it. Secrets (the SMTP
# password, the invite code, the admin password) stay on the host.

# The public site, where members use stroj. It is what goes in the email
# confirmation and password-reset links, so they open on the same site (and
# sign the member in there) rather than on the judge's own hostname.
STROJ_BASE_URL=https://stroj.ethanyanxu.com
