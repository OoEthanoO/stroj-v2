{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build-static.sh",
  "outputDirectory": "public",
  "installCommand": "echo 'no dependencies'",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://JUDGE_ORIGIN/api/:path*" },
    { "source": "/healthz", "destination": "https://JUDGE_ORIGIN/healthz" },
    { "source": "/docs", "destination": "https://JUDGE_ORIGIN/docs" },
    { "source": "/openapi.json", "destination": "https://JUDGE_ORIGIN/openapi.json" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
